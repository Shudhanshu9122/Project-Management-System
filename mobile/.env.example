# Base URL of the API, including the /api prefix and no trailing slash.
# Baked into the JS bundle by Metro, so a change needs a restart with --clear.

# Android emulator (10.0.2.2 is the host machine as seen from the emulator)
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api

# Physical device on the same Wi-Fi - use your machine's LAN IP
# EXPO_PUBLIC_API_URL=http://192.168.1.20:4000/api

# Deployed backend
# EXPO_PUBLIC_API_URL=https://pms-api.onrender.com/api

# Optional: only needed for an EAS build against a tunnel
# EXPO_NO_TELEMETRY=1
