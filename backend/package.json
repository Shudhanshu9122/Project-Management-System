{
  "name": "pms-backend",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for the Project Management System",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/scripts/migrate.js",
    "seed": "node src/scripts/seed.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "db:local:start": "node src/scripts/localDb.js start",
    "db:local:stop": "node src/scripts/localDb.js stop"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.12.0",
    "winston": "^3.14.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@embedded-postgres/windows-x64": "^17.6.0-beta.15",
    "embedded-postgres": "^17.6.0-beta.15",
    "supertest": "^7.0.0"
  }
}
