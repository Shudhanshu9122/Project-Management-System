# Runtime
NODE_ENV=development
PORT=4000

# Fail-fast required values
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pms
JWT_SECRET=local-development-secret-change-me-please

# Used only by the test suite; defaults to DATABASE_URL if unset.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pms_test

# Auth
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
DATABASE_POOL_MAX=10

# Comma separated allow-list. Requests without an Origin header (mobile) are always allowed.
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# Logging: error | warn | info | debug
LOG_LEVEL=debug
